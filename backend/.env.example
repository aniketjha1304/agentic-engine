# API Configuration
API_KEY=your_api_key_here

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=agentic_engine

# Azure OpenAI Configuration
AZURE_GPT4O_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
AZURE_GPT4O_KEY=your_azure_openai_key
AZURE_GPT4O_API_VERSION=2024-02-15-preview

# Optional: Azure OpenAI Realtime (for voice)
AZURE_GPT4O_REALTIME_PREVIEW_URL=https://your-resource.openai.azure.com/openai/realtime
AZURE_GPT4O_REALTIME_PREVIEW_KEY=your_realtime_key
